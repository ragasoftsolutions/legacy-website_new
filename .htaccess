# Legacy Migration Frontend - API Proxy Configuration
# LiteSpeed / Apache .htaccess

RewriteEngine On

# Route /api/ngenius/* to ngenius.php proxy
RewriteRule ^api/ngenius/(.*)$ public/api/ngenius.php?_path=$1 [L,QSA]

# Route /api/zeptomail/* to zeptomail.php proxy
RewriteRule ^api/zeptomail/(.*)$ public/api/zeptomail.php?_path=$1 [L,QSA]

# Handle SPA routing - all other routes go to index.html
# This ensures Vue Router works correctly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]