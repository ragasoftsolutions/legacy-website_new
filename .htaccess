<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# React Routing
RewriteRule ^index\.html$ - [L]

# PHP API Routes
RewriteRule ^api/ngenius/(.*)$ /api/ngenius.php [QSA,L]
RewriteRule ^api/zeptomail/(.*)$ /api/zeptomail.php [QSA,L]
RewriteRule ^api/test$ /api/test.php [QSA,L]

# React SPA fallback
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

</IfModule>